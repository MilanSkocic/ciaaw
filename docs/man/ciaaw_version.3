.TH ciaaw_version 3 "17 July 2026" "1.3.2" "Library Functions Manual"

.SH NAME
\"{{{
version \- function
\"}}}

.SH LIBRARY
\"{{{
ciaaw library 
.RI ( libciaaw ", " \-lciaaw )
\"}}}

.SH SYNOPSIS
\"{{{ 
.IP Fortran 10
.BI "function version()result(" fptr ")"
.RS
.IP "" 3
.BI "character(len=:), pointer :: " fptr 
.RE

.IP C 10
.B char* ciaaw_version()

.IP Python 10
.BI str: pyciaaw.__version__
\"}}}

.SH DESCRIPTION
\"{{{
Get the library version.
\"}}}

.SH RETURN VALUE
\"{{{
.IP pointer 10 
Pointer to the version string.
\"}}}

.SH EXAMPLE
\"{{{
.PP
Fortran:
.nf
.ft CR
    use ciaaw
    print *, "version = ", version()
.ft R
.fi

.PP
C:
.nf
.ft CR
    include <stdio.h>
    include "ciaaw.h"
    printf("version = %s\\n", ciaaw_version());
.ft R
.fi

.PP
Python:
.nf
.ft CR
    import pyciaaw
    print(f"version = {pyciaaw.__version__}")
.ft R
.fi
\"}}}

.SH SEE ALSO
.BR ciaaw (3),
.BR ciaaw_cli (1),
.BR ciaaw_version (3),
.BR ciaaw_saw (3),
.BR ciaaw_ice (3),
.BR ciaaw_nice (3),
.BR ciaaw_naw (3), 
.BR ciaaw_nnaw (3)
